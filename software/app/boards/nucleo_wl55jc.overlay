/ {
	aliases {
		led0 = &status_led;
		gps-uart = &usart1;
		rf-v1 = &rf_switch_v1;
        rf-v2 = &rf_switch_v2;
		sensor-i2c = &i2c1;
	};

	chosen {
		zephyr,console = &lpuart1;
		zephyr,shell-uart = &lpuart1;
	};

	leds {
		compatible = "gpio-leds";
		status_led: led_0 {
			gpios = <&gpioa 0 GPIO_ACTIVE_HIGH>;
			label = "Status LED on PA0";
		};
	};

	rf_switch {
		compatible = "gpio-leds";

		rf_switch_v1: v1 {
            gpios = <&gpiob 8 GPIO_ACTIVE_HIGH>;
            label = "RF Switch V1 Control";
        };

        rf_switch_v2: v2 {
            gpios = <&gpiob 12 GPIO_ACTIVE_HIGH>;
            label = "RF Switch V2 Control";
        };
	};
};

/* UART1 configuration for GPS-module */
&usart1 {
	status = "okay";
	current-speed = <9600>; /* default setting of L80-R */
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
};

/* I2C1 configuration for gas sensors */
&i2c1 {
	status = "okay";
	pinctrl-0 = <&i2c1_scl_pb6 &i2c1_sda_pb7>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>; /* 100 kHz, or I2C_BITRATE_FAST for 400 kHz */

	bme680: bme680@76 {
        compatible = "bosch,bme680";
        reg = <0x76>;                            
        label = "BME680_ENVIRONMENT_SENSOR";
    };
};