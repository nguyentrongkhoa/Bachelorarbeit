/ {
	aliases {
		led0 = &status_led;
		gps-uart = &usart1;
		sensor-i2c = &i2c1;
		lora0 = &lora;
	};

	chosen {
		zephyr,console = &lpuart1;
		zephyr,shell-uart = &lpuart1;
	};

	leds {
		compatible = "gpio-leds";
		status_led: led_0 {
			gpios = <&gpioa 0 GPIO_ACTIVE_HIGH>;
			label = "Status LED on PA0";
		};
	};
};

/* UART1 configuration for GPS-module */
&usart1 {
	status = "okay";
	current-speed = <9600>; /* default setting of L80-R */
	pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
	pinctrl-names = "default";
};

/* I2C1 configuration for gas sensors */
&i2c1 {
	status = "okay";
	pinctrl-0 = <&i2c1_scl_pb6 &i2c1_sda_pb7>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>; /* 100 kHz, or I2C_BITRATE_FAST for 400 kHz */

	bme680: bme680@76 {
        compatible = "bosch,bme680";
        reg = <0x76>;                            
        label = "BME680_ENVIRONMENT_SENSOR";
    };
};

&subghzspi {
    status = "okay";

    lora: radio@0 {
        status = "okay";
        rx-enable-gpios = <&gpiob 8 GPIO_ACTIVE_HIGH>; 
        tx-enable-gpios = <&gpiob 12 GPIO_ACTIVE_HIGH>; 
        dio3-tcxo-voltage = <SX126X_DIO3_TCXO_1V7>;
        tcxo-power-startup-delay-ms = <5>;
        power-amplifier-output = "rfo-lp";
        rfo-lp-max-power = <15>;
        rfo-hp-max-power = <22>;
    };
};