// STM32WL55 Renode Platform Description
// Based on RM0453 Reference Manual

// The STM32WL55 is a dual-core MCU, but here we define the main Cortex-M4
cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4f"
    nvic: nvic

nvic: IRQControllers.NVIC @ sysbus 0xE000E100

// --- Memory ---
// Flash memory: up to 256 KB starting at 0x08000000 [cite: 16]
flash: Memory.MappedMemory @ sysbus 0x08000000
    size: 0x40000

// SRAM1: 32 KB starting at 0x20000000 
sram1: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x8000

// SRAM2: 32 KB starting at 0x20008000 
sram2: Memory.MappedMemory @ sysbus 0x20008000
    size: 0x8000

// --- System Peripherals ---
//rcc: STM32.STM32L4_RCC @ sysbus 0x40021000
    // Reset and Clock Control [cite: 67, 70]

// --- GPIO Ports [cite: 19, 20] ---
// https://github.com/renode/renode-infrastructure/blob/master/src/Emulator/Peripherals/Peripherals/GPIOPort/STM32_GPIOPort.cs
gpioPortA: GPIOPort.STM32_GPIOPort @ sysbus <0x48000000, +0x400>
    // RM0453 Section 11.5
    modeResetValue: 0xABFFFFFF
    outputSpeedResetValue: 0x0C000000
    pullUpPullDownResetValue: 0x64000000
    numberOfAFs: 16
    // TODO:
    //[0-15] -> exti@[0-15]

gpioPortB: GPIOPort.STM32_GPIOPort @ sysbus <0x48000400, +0x400>
    modeResetValue: 0xFFFFFEBF
    outputSpeedResetValue: 0x00000000
    pullUpPullDownResetValue: 0x00000100
    numberOfAFs: 16
    [0-15] -> nvic@[6, 7, 8, 9, 10, 23, 23, 23, 23, 23, 40, 40, 40, 40, 40, 40]
    //[0-15] -> exti@[0-15]

gpioPortC: GPIOPort.STM32_GPIOPort @ sysbus <0x48000800, +0x400>
    modeResetValue: 0xFFFFFFFF
    numberOfAFs: 16
    [13-15] -> nvic@[40, 40, 40]
    //[0-15] -> exti@[0-15]

