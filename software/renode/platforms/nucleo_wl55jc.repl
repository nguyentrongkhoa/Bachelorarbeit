using "stm32wl55.repl"

// PB15 (pin B4 on Nucleo board)
LED1: Miscellaneous.LED @ gpioPortB 15
LED2: Miscellaneous.LED @ gpioPortB 9
LED3: Miscellaneous.LED @ gpioPortB 11

// User buttons
// Note: B1 can be configured to connect to one of 3 pins: PA0 (main), PC13
B1: Miscellaneous.Button @ gpioPortA 0
    -> gpioPortA@0
B2: Miscellaneous.Button @ gpioPortA 1
    -> gpioPortA@1
B3: Miscellaneous.Button @ gpioPortC 6
    -> gpioPortC@6