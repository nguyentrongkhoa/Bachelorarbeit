emulation CreateWirelessMedium "lora_medium"

# 2. Créer ta machine (ton STM32WL)
mach create "node1"
machine LoadPlatformDescription @mon_projet/stm32wl.repl

# 3. Connecter la radio au médium
# (En supposant que 'radio' est le nom défini dans ton .repl)
lora_medium SetRange radio 100

# 4. Charger ton code Zephyr
sysbus LoadELF @app/build/zephyr/zephyr.elf